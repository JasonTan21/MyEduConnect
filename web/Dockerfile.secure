# Hardened web image for Phase 5 re-test.
# Remediates: E7 (no SSH server / no default creds), E9 (no world-writable dirs),
# E10 (no sudo backup script). Runs as a non-root user. App runs in locked secure mode.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends default-mysql-client curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root application user (defence in depth).
RUN useradd -m -u 10001 appuser

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Least-privilege upload directory (fixes E9 world-writable 777).
RUN mkdir -p /app/uploads \
    && chown -R appuser:appuser /app \
    && chmod 750 /app/uploads

USER appuser
EXPOSE 8080
# No `service ssh start`; debug disabled via FLASK_DEBUG=0 in compose.
CMD ["python", "app.py"]
